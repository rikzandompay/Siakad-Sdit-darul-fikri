@startuml SisforSinta_UseCase
left to right direction

skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #B4D7FF
skinparam usecaseBorderColor #4A90E2
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #000000
skinparam defaultFontColor #000000
skinparam defaultFontName Arial
skinparam defaultFontSize 11

' Aktor Kiri
actor "Guru" as Guru
actor "Wali Kelas" as WaliKelas

' Aktor Kanan
actor "Kepala Sekolah" as KepalaSekolah

rectangle "Sistem Informasi Akademik Darul Fikri" {
    usecase "Mengolah Data Siswa" as UC_DataSiswa
    usecase "Mengolah Mata Pelajaran" as UC_MataPelajaran
    usecase "Mengolah Jadwal Akademik" as UC_JadwalAkademik

    usecase "Mengolah Data Presensi Kehadiran" as UC_Presensi
    usecase "Mengolah Data Presensi Sholat" as UC_PresensiSholat
    usecase "Mengolah Data Nilai Rapot" as UC_NilaiRapot
    
    usecase "Menghasilkan Laporan" as UC_Laporan
}

' Relasi Aktor Kiri -- Use Case
Guru -- UC_DataSiswa
Guru -- UC_MataPelajaran
Guru -- UC_JadwalAkademik

WaliKelas -- UC_Presensi
WaliKelas -- UC_PresensiSholat
WaliKelas -- UC_NilaiRapot
WaliKelas -- UC_Laporan

' Relasi Use Case -- Aktor Kanan
UC_Laporan -- KepalaSekolah
UC_DataSiswa -- KepalaSekolah
UC_MataPelajaran -- KepalaSekolah
UC_JadwalAkademik -- KepalaSekolah
UC_NilaiRapot -- KepalaSekolah

@enduml
